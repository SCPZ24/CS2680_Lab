diff --git a/src/game/state/playerState.ts b/src/game/state/playerState.ts
index f3a220b..0e52e6a 100644
--- a/src/game/state/playerState.ts
+++ b/src/game/state/playerState.ts
@@ -8,7 +8,8 @@ export function createInitialPlayerState(): PlayerState {
     shield: 60,
     lastDamageAt: -Infinity,
     shieldRecoveryDelayMs: 1000,
-    shieldRecoveryPerSecond: 18
+    shieldRecoveryPerSecond: 18,
