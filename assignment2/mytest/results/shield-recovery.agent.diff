   };
 }
 
@@ -35,7 +36,10 @@ export function tickShieldRecovery(player: PlayerState, timestamp: number): Play
   const eligibleAt = player.lastDamageAt + player.shieldRecoveryDelayMs;
   if (timestamp < eligibleAt) return player;
 
-  const deltaSeconds = (timestamp - eligibleAt) / 1000;
+  const totalElapsed = (timestamp - eligibleAt) / 1000;
+  const deltaSeconds = Math.max(0, totalElapsed - player.elapsedRecoveryTime);
+  const elapsedRecoveryTime = player.elapsedRecoveryTime + deltaSeconds;
+
   const recoveredShield = Math.min(
     player.maxShield,
     player.shield + deltaSeconds * player.shieldRecoveryPerSecond
@@ -43,7 +47,8 @@ export function tickShieldRecovery(player: PlayerState, timestamp: number): Play
 
   return {
     ...player,
-    shield: recoveredShield
+    shield: recoveredShield,
+    elapsedRecoveryTime
   };
 }
 
